{
  "components": {
    "schemas": {
      "ErrorEnvelope": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "AUTHENTICATION_REQUIRED",
              "PERMISSION_DENIED",
              "VALIDATION_FAILED",
              "REVISION_CONFLICT",
              "IDEMPOTENCY_CONFLICT",
              "DEPENDENCY_UNAVAILABLE",
              "SCHEMA_UNSUPPORTED",
              "NOT_FOUND"
            ],
            "title": "Code",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          }
        },
        "required": [
          "code",
          "reason"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "OperationReceipt": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "const": "project.create.v1",
            "default": "project.create.v1",
            "title": "Command",
            "type": "string"
          },
          "committed_at": {
            "title": "Committed At",
            "type": "string"
          },
          "operation_id": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
            "title": "Operation Id",
            "type": "string"
          },
          "outcome": {
            "const": "CANONICAL_COMMITTED",
            "default": "CANONICAL_COMMITTED",
            "title": "Outcome",
            "type": "string"
          },
          "project": {
            "$ref": "#/components/schemas/ProjectCreated"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          }
        },
        "required": [
          "operation_id",
          "committed_at",
          "project"
        ],
        "title": "OperationReceipt",
        "type": "object"
      },
      "ProjectCreate": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "default": "",
            "maxLength": 2000,
            "title": "Description",
            "type": "string"
          },
          "expected_policy_revision": {
            "minimum": 1.0,
            "title": "Expected Policy Revision",
            "type": "integer"
          },
          "idempotency_key": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
            "title": "Idempotency Key",
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "provider_mode": {
            "default": "INHERIT",
            "enum": [
              "INHERIT",
              "NARROW",
              "LOCAL_ONLY"
            ],
            "title": "Provider Mode",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "selected_providers": {
            "anyOf": [
              {
                "items": {
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
                  "type": "string"
                },
                "maxItems": 128,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Selected Providers"
          }
        },
        "required": [
          "schema_version",
          "idempotency_key",
          "name",
          "expected_policy_revision"
        ],
        "title": "ProjectCreate",
        "type": "object"
      },
      "ProjectCreated": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "maxLength": 2000,
            "title": "Description",
            "type": "string"
          },
          "instruction_authority_ref": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
            "title": "Instruction Authority Ref",
            "type": "string"
          },
          "instruction_owner": {
            "const": "ENVIRONMENT",
            "default": "ENVIRONMENT",
            "title": "Instruction Owner",
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "project_id": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
            "title": "Project Id",
            "type": "string"
          },
          "provider_allowance_at_creation": {
            "$ref": "#/components/schemas/ProviderSnapshot"
          },
          "resource_refs": {
            "items": {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
              "type": "string"
            },
            "title": "Resource Refs",
            "type": "array"
          },
          "revision": {
            "minimum": 1.0,
            "title": "Revision",
            "type": "integer"
          },
          "verification_policy_ref": {
            "anyOf": [
              {
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verification Policy Ref"
          }
        },
        "required": [
          "project_id",
          "revision",
          "name",
          "description",
          "instruction_authority_ref",
          "provider_allowance_at_creation",
          "verification_policy_ref",
          "resource_refs"
        ],
        "title": "ProjectCreated",
        "type": "object"
      },
      "ProviderSnapshot": {
        "additionalProperties": false,
        "description": "Historical consent only; never proof of current egress/route eligibility.",
        "properties": {
          "approval_id": {
            "anyOf": [
              {
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Id"
          },
          "interpretation": {
            "const": "HISTORICAL_CREATION_SNAPSHOT",
            "default": "HISTORICAL_CREATION_SNAPSHOT",
            "title": "Interpretation",
            "type": "string"
          },
          "mode": {
            "enum": [
              "INHERIT",
              "NARROW",
              "LOCAL_ONLY"
            ],
            "title": "Mode",
            "type": "string"
          },
          "policy_revision": {
            "minimum": 1.0,
            "title": "Policy Revision",
            "type": "integer"
          },
          "providers": {
            "items": {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
              "type": "string"
            },
            "title": "Providers",
            "type": "array"
          }
        },
        "required": [
          "mode",
          "policy_revision",
          "approval_id",
          "providers"
        ],
        "title": "ProviderSnapshot",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Journeon foundation",
    "version": "0.0.0.dev1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/operations/{operation_id}": {
      "get": {
        "operationId": "getOperationReceipt",
        "parameters": [
          {
            "in": "path",
            "name": "operation_id",
            "required": true,
            "schema": {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
              "title": "Operation Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationReceipt"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Conflict"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Get Receipt",
        "x-journeon-owner": "operations",
        "x-journeon-permissions": [
          "project.receipt.read"
        ],
        "x-journeon-query": "operation.receipt.read.v1"
      }
    },
    "/api/v1/projects": {
      "post": {
        "operationId": "createProject",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationReceipt"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Conflict"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Create Project",
        "x-journeon-command": "project.create.v1",
        "x-journeon-owner": "projects",
        "x-journeon-permissions": [
          "project.create",
          "project.receipt.read"
        ]
      }
    }
  }
}
